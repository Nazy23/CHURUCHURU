int sensorValue = 0;

void setup()
{
  pinMode(A0, INPUT);
  pinMode(13, OUTPUT);
  pinMode(12, OUTPUT);
  pinMode(11, OUTPUT);
  pinMode(10, OUTPUT);

}

void loop()
{
  sensorValue = analogRead(A0);
  digitalWrite(13, HIGH);
    delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(13, LOW);
  digitalWrite(12, HIGH);
    delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(12, LOW);
  digitalWrite(11, HIGH);
    delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(11, LOW);
  digitalWrite(10, HIGH);
    delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(10, LOW);
    delay(sensorValue); // Wait for sensorValue millisecond(s)

  digitalWrite(10, HIGH);
      delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(10, LOW);
  digitalWrite(11, HIGH);
      delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(11, LOW);
  digitalWrite(12, HIGH);
    delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(12, LOW);
  digitalWrite(13, HIGH);
    delay(sensorValue); // Wait for sensorValue millisecond(s)
  digitalWrite(13, LOW);
      delay(sensorValue); // Wait for sensorValue millisecond(s)



}
